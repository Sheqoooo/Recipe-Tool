{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-tool",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "REPLACE_WITH_EXISTING_D1_NAME", "database_id": "11111111-1111-4111-8111-111111111111", "migrations_dir": "migrations" }],
  "vars": {
    "APP_ENV": "production", "AUTH_MODE": "access",
    "APP_ORIGIN": "https://REPLACE_WITH_APP_DOMAIN",
    "ACCESS_ISSUER": "https://REPLACE_WITH_TEAM.cloudflareaccess.com", "ACCESS_AUD": "REPLACE_WITH_APPLICATION_AUD",
    "BOOTSTRAP_ADMIN_EMAILS": "", "RECIPE_ALLOWED_HOSTS": "",
    "OPENAI_MODEL": "gpt-5.4-mini", "MODEL_INPUT_USD_PER_MILLION": "0.75", "MODEL_OUTPUT_USD_PER_MILLION": "4.50",
    "MAX_PARALLEL_IMPORTS": "2", "USER_IMPORTS_PER_MINUTE": "5", "USER_IMPORTS_PER_DAY": "30",
    "DAILY_BUDGET_MICROUSD": "2000000", "MONTHLY_BUDGET_MICROUSD": "10000000"
  },
  "previews": {
    "vars": {
      "APP_ENV": "preview", "AUTH_MODE": "access",
      "ACCESS_ISSUER": "https://REPLACE_WITH_TEAM.cloudflareaccess.com", "ACCESS_AUD": "REPLACE_WITH_PREVIEW_AUD"
    },
    "d1_databases": []
  }
}
